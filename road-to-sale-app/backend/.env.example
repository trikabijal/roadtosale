# Road to Sale Core API — environment variables (copy to .env; .env is gitignored)

# --- Database (dev profile) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/roadtosale
SPRING_DATASOURCE_USERNAME=roadtosale
SPRING_DATASOURCE_PASSWORD=roadtosale

# --- Auth ---
# Secret used to sign/verify JWTs. Access token lives 1h, refresh token 30d.
JWT_SECRET=change-me-to-a-long-random-string

# --- Photo storage (local disk now; S3 later) ---
STORAGE_DIR=./data/photos

# --- Server ---
# Core API listens on 8090 by default (see application.yml).
