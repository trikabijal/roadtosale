# ─── SmartComply backend ─────────────────────────────────────────────────────
# Base URL of the SmartComply REST API (no trailing slash).
# Local dev default: the Spring Boot server started by ./build.sh in the
# smartcomply/ repo (port 8089).
SMARTCOMPLY_API_URL=http://localhost:8089

# ─── Honda tenant identifiers ────────────────────────────────────────────────
# The SmartComply tenant identifier for Honda US.
TENANT_ID=honda

# Honda Road to Sale checksheet template ID (seed: V200.003).
# This is the chks_header.checksheet_id value for RTS_HONDA_V1.
SMARTCOMPLY_TEMPLATE_ID=2001

# Audit campaign ID for the standing walk-in campaign (seed: V200.003).
# All walk-in sessions are created under this audit_id via
# POST /api/audit/addAuditAssignments.
SMARTCOMPLY_WALKIN_AUDIT_ID=1

# ─── Expo public config ───────────────────────────────────────────────────────
# These variables are prefixed EXPO_PUBLIC_ so they are inlined by the Metro
# bundler at build time and available via Constants.expoConfig.extra.
# Override per-environment in CI; keep values matching SMARTCOMPLY_API_URL above
# for local dev.
EXPO_PUBLIC_SMARTCOMPLY_API_URL=http://localhost:8089
