{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@api/*": ["src/api/*"],
      "@components/*": ["src/components/*"],
      "@crm/*": ["src/crm/*"],
      "@db/*": ["src/db/*"],
      "@navigation/*": ["src/navigation/*"],
      "@screens/*": ["src/screens/*"],
      "@session/*": ["src/session/*"],
      "@theme/*": ["src/theme/*"],
      "@voice/*": ["src/voice/*"]
    }
  }
}
