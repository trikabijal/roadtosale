# Road to Sale BFF — environment variables (copy to .env; .env is gitignored)

# Port the BFF listens on. 8089 keeps the existing app config working.
PORT=8089

# Base URL of the Core API (Java/Spring) the BFF relays to.
CORE_BASE_URL=http://localhost:8090

# Secret used to verify JWTs issued by the Core (must match Core's JWT_SECRET).
JWT_SECRET=change-me-to-a-long-random-string
